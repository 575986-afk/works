<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.sist.sysadmin.AdminMapper">

	<!--
	  ADMIN 테이블(기존에 이미 존재, admin01~04 시드 데이터 있음):
	  ADMIN_NO, ADMIN_ID, PASSWORD(평문), ADMIN_NAME, EMAIL, PHONENUMBER, REG_DATE
	  SYS_ADMIN은 더 이상 사용하지 않음 (안 만들었으면 안 만들어도 됨).
	-->

	<select id="selectAdminById" resultType="sysAdminDomain">
		SELECT
			ADMIN_NO      AS adminNo,
			ADMIN_ID      AS adminId,
			PASSWORD      AS adminPw,
			ADMIN_NAME    AS adminName,
			EMAIL         AS email,
			PHONENUMBER   AS phoneNumber,
			REG_DATE      AS regDate
		FROM ADMIN
		WHERE ADMIN_ID = #{adminId}
	</select>

</mapper>
